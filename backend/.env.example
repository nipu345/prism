# Supabase project settings (Project Settings → API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# Optional — Gemini narrative layer. Analysis works fine without this key,
# it just skips the AI executive summary. Get a free key at
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional — Node/Nodemailer notification microservice (see /notifications).
# Analysis works fine without this running, it just skips the email.
NOTIFY_SERVICE_URL=http://localhost:4000/notify-report
NOTIFY_SERVICE_API_KEY=change-me

# Used to build the "view your results" link in notification emails
FRONTEND_URL=http://localhost:5173
